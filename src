            endRow = rows - 2;
            endCol = cols - 1;
        }

        maze[startRow][startCol] = PATH;
        maze[endRow][endCol] = PATH;


        boolean[][] visited = new boolean[rows][cols];
        boolean pathFound = findPath(maze, visited, startRow, startCol, endRow, endCol);


        if (pathFound) {
            System.out.println("\nMaze with path:\n");
            printMazeWithPath(maze);
        } else {
            System.out.println("No path found from start to exit.");
        }

        scanner.close();
