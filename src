    // Generate maze using recursive backtracking
    private static int[][] generateMaze(int rows, int cols) {
        rows = (rows % 2 == 0) ? rows + 1 : rows;
        cols = (cols % 2 == 0) ? cols + 1 : cols;

        int[][] maze = new int[rows][cols];
        Random rand = new Random();

        // Fill all cells as walls initially
        for (int r = 0; r < rows; r++)
            for (int c = 0; c < cols; c++)
                maze[r][c] = WALL;

        // Start carving paths from (1,1)
        carvePath(maze, 1, 1, rand);
        return maze;
    }


    private static void carvePath(int[][] maze, int r, int c, Random rand) {
        int[] dr = {0, 0, 2, -2}; // Directions (down/up)
        int[] dc = {2, -2, 0, 0}; // Directions (right/left)
        shuffle(dr, dc, rand);   // Shuffle directions for randomness

        for (int i = 0; i < 4; i++) {
            int nr = r + dr[i];
            int nc = c + dc[i];

            if (isInBounds(nr, nc, maze) && maze[nr][nc] == WALL) {
                // Remove wall between current and neighbor
                maze[r + dr[i] / 2][c + dc[i] / 2] = PATH;
                maze[nr][nc] = PATH;
                carvePath(maze, nr, nc, rand);
            }
        }
    }

    // Recursive DFS pathfinding from start to exit
    private static boolean findPath(int[][] maze, boolean[][] visited, int r, int c, int endR, int endC) {
        // Base cases
        if (!isInBounds(r, c, maze) || maze[r][c] == WALL || visited[r][c])
            return false;

        visited[r][c] = true;

        // Found exit
        if (r == endR && c == endC) {
            maze[r][c] = VISITED;
            return true;
        }

        // Explore in 4 directions
        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        for (int i = 0; i < 4; i++) {
            int nr = r + dr[i];
            int nc = c + dc[i];

            if (findPath(maze, visited, nr, nc, endR, endC)) {
                maze[r][c] = VISITED;
                return true;
            }
        }

        return false;
    }

    // Check if coordinates are within maze bounds
    private static boolean isInBounds(int r, int c, int[][] maze) {
        return r >= 0 && r < maze.length && c >= 0 && c < maze[0].length;
    }

    // Check if a cell is a valid place to start or end
    private static boolean isValidEntry(int r, int c, int[][] maze) {
        return isInBounds(r, c, maze) && maze[r][c] != WALL;
    }


    private static void shuffle(int[] dr, int[] dc, Random rand) {
        for (int i = dr.length - 1; i > 0; i--) {
            int j = rand.nextInt(i + 1);
            int tmp = dr[i]; dr[i] = dr[j]; dr[j] = tmp;
            tmp = dc[i]; dc[i] = dc[j]; dc[j] = tmp;
        }
    }


    private static void printMazeWithPath(int[][] maze) {
        for (int r = 0; r < maze.length; r++) {
            for (int c = 0; c < maze[0].length; c++) {
                if (maze[r][c] == WALL) {
                    System.out.print("#");
                } else if (maze[r][c] == VISITED) {
                    System.out.print(".");
                } else {
                    System.out.print(" ");
                }
            }
            System.out.println();
        }
    }
