// Get valid exit position
        int endRow ;
        int endCol;
        while (true) {
            System.out.print("Enter exit row (default " + (rows - 2) + "): ");
            endRow = scanner.nextInt();
            System.out.print("Enter exit col (default " + (cols - 1) + "): ");
